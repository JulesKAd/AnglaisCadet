<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VTEST Speaking Practice</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        primary: '#2563eb',
                        secondary: '#475569',
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
        }
        .recording-pulse {
            animation: pulse-red 1.5s infinite;
        }
        @keyframes pulse-red {
            0% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.4); }
            70% { box-shadow: 0 0 0 15px rgba(239, 68, 68, 0); }
            100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
        }
        .fade-in {
            animation: fadeIn 0.4s ease-in-out;
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .recording-pulse-text {
            animation: pulse-text 1.5s infinite;
        }
        @keyframes pulse-text {
            0% { opacity: 1; }
            50% { opacity: 0.5; }
            100% { opacity: 1; }
        }
    </style>
</head>
<body class="min-h-screen flex flex-col text-slate-800">

    <header class="bg-white shadow-sm sticky top-0 z-10">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center gap-2 text-primary font-bold text-xl cursor-pointer" onclick="goHome()">
                <i class="fa-solid fa-microphone-lines"></i>
                <span>VTEST Prep</span>
            </div>
            <button onclick="goHome()" class="text-sm font-medium text-slate-500 hover:text-slate-900 transition-colors">
                <i class="fa-solid fa-house mr-1"></i> Accueil
            </button>
        </div>
    </header>

    <main class="flex-grow w-full max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        
        <!-- ================= HOME VIEW ================= -->
        <div id="home-view" class="fade-in">
            <div class="text-center mb-10">
                <h1 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4">Entraînement à l'Expression Orale</h1>
                <p class="text-lg text-slate-600 max-w-2xl mx-auto">Choisissez une partie de l'examen pour commencer à vous entraîner. Enregistrez vos réponses et réécoutez-les pour évaluer vos performances.</p>
            </div>

            <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
                <!-- Part 2 Card -->
                <div class="bg-white rounded-2xl p-8 shadow-sm border border-slate-200 hover:shadow-md transition-shadow flex flex-col items-center text-center">
                    <div class="w-16 h-16 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center text-2xl mb-6">
                        <i class="fa-solid fa-book-open-reader"></i>
                    </div>
                    <h2 class="text-2xl font-bold mb-3">Partie 2 : Lecture et Questions</h2>
                    <p class="text-slate-600 mb-6 flex-grow">Lisez un texte à voix haute (Compréhension), puis répondez à deux questions associées (Analyse et Opinion personnelle).</p>
                    <ul class="text-sm text-slate-500 mb-8 space-y-2 text-left w-full bg-slate-50 p-4 rounded-lg">
                        <li><i class="fa-solid fa-check text-green-500 mr-2"></i> 1 Texte à lire</li>
                        <li><i class="fa-solid fa-check text-green-500 mr-2"></i> 2 Questions de réflexion</li>
                        <li><i class="fa-solid fa-check text-green-500 mr-2"></i> ~4 minutes estimées</li>
                    </ul>
                    <button onclick="startExercise('part2')" class="w-full bg-primary hover:bg-blue-700 text-white font-semibold py-3 px-6 rounded-xl transition-colors">
                        Commencer la Partie 2
                    </button>
                </div>

                <!-- Part 3 Card -->
                <div class="bg-white rounded-2xl p-8 shadow-sm border border-slate-200 hover:shadow-md transition-shadow flex flex-col items-center text-center">
                    <div class="w-16 h-16 bg-purple-100 text-purple-600 rounded-full flex items-center justify-center text-2xl mb-6">
                        <i class="fa-regular fa-images"></i>
                    </div>
                    <h2 class="text-2xl font-bold mb-3">Partie 3 : Analyse Visuelle</h2>
                    <p class="text-slate-600 mb-6 flex-grow">Observez deux images puis répondez à trois questions : Description, Comparaison, et Opinion personnelle.</p>
                    <ul class="text-sm text-slate-500 mb-8 space-y-2 text-left w-full bg-slate-50 p-4 rounded-lg">
                        <li><i class="fa-solid fa-check text-green-500 mr-2"></i> 2 Images à observer</li>
                        <li><i class="fa-solid fa-check text-green-500 mr-2"></i> 3 Questions d'analyse</li>
                        <li><i class="fa-solid fa-check text-green-500 mr-2"></i> ~4 minutes estimées</li>
                    </ul>
                    <button onclick="startExercise('part3')" class="w-full bg-purple-600 hover:bg-purple-700 text-white font-semibold py-3 px-6 rounded-xl transition-colors">
                        Commencer la Partie 3
                    </button>
                </div>
            </div>
        </div>

        <!-- ================= EXERCISE VIEW ================= -->
        <div id="exercise-view" class="hidden fade-in max-w-4xl mx-auto">
            
            <!-- Progress / Step Indicator -->
            <div class="mb-6">
                <div class="flex justify-between text-sm font-medium text-slate-500 mb-2">
                    <span id="step-label">Étape 1 sur 3</span>
                    <span id="mode-label" class="uppercase tracking-wider text-xs bg-slate-200 py-1 px-2 rounded">Partie X</span>
                </div>
                <div class="w-full bg-slate-200 rounded-full h-2">
                    <div id="progress-bar" class="bg-primary h-2 rounded-full transition-all duration-300" style="width: 33%;"></div>
                </div>
            </div>

            <!-- Content Area (Text or Images) -->
            <div id="exercise-context" class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 sm:p-8 mb-6">
                <!-- Injected via JS -->
            </div>

            <!-- Question and Controls Area -->
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 sm:p-8 text-center relative overflow-hidden">
                <div id="exercise-prompt" class="text-xl sm:text-2xl font-semibold text-slate-800 mb-8">
                    <!-- Question injected via JS -->
                </div>

                <!-- Audio Error Message -->
                <div id="mic-error" class="hidden bg-red-50 text-red-600 p-4 rounded-lg mb-6 text-sm flex items-start text-left">
                    <i class="fa-solid fa-triangle-exclamation mt-1 mr-3"></i>
                    <div>
                        <strong>Erreur de microphone:</strong> Impossible d'accéder au microphone. Veuillez vérifier les permissions de votre navigateur et vous assurer qu'aucun autre programme ne l'utilise.
                    </div>
                </div>

                <!-- Controls -->
                <div class="flex flex-col items-center gap-6">
                    <!-- Timer -->
                    <div class="flex flex-col items-center">
                        <span id="timer-label" class="text-sm font-bold uppercase tracking-wider mb-1 text-orange-500">Temps de préparation</span>
                        <div id="timer-display" class="text-4xl font-mono font-bold text-slate-700 tracking-wider transition-colors duration-300">
                            00:30
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="flex flex-col sm:flex-row gap-4 w-full justify-center">
                        <button id="record-btn" onclick="startRecording()" class="bg-red-500 hover:bg-red-600 text-white font-medium py-3 px-8 rounded-full transition-colors flex items-center justify-center gap-2 shadow-lg shadow-red-500/30">
                            <i class="fa-solid fa-microphone"></i> Commencer l'enregistrement
                        </button>
                        
                        <button id="stop-btn" onclick="stopRecording()" class="hidden bg-slate-800 hover:bg-slate-900 text-white font-medium py-3 px-8 rounded-full transition-colors flex items-center justify-center gap-2 recording-pulse">
                            <i class="fa-solid fa-stop"></i> Arrêter l'enregistrement
                        </button>

                        <button id="next-btn" onclick="nextStep()" class="hidden bg-primary hover:bg-blue-700 text-white font-medium py-3 px-8 rounded-full transition-colors flex items-center justify-center gap-2 shadow-lg shadow-blue-500/30">
                            Étape suivante <i class="fa-solid fa-arrow-right"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- ================= REVIEW VIEW ================= -->
        <div id="review-view" class="hidden fade-in max-w-3xl mx-auto">
            <div class="text-center mb-10">
                <div class="w-16 h-16 bg-green-100 text-green-600 rounded-full flex items-center justify-center text-3xl mx-auto mb-4">
                    <i class="fa-solid fa-check-circle"></i>
                </div>
                <h2 class="text-3xl font-bold text-slate-900 mb-2">Exercice Terminé !</h2>
                <p class="text-lg text-slate-600">Voici vos enregistrements. Écoutez-les pour évaluer votre fluidité et la pertinence de vos réponses.</p>
            </div>

            <div id="review-list" class="space-y-6 mb-10">
                <!-- Review items injected via JS -->
            </div>

            <div class="flex justify-center">
                <button onclick="goHome()" class="bg-white border-2 border-slate-300 hover:border-slate-400 text-slate-700 font-semibold py-3 px-8 rounded-xl transition-colors flex items-center gap-2">
                    <i class="fa-solid fa-rotate-left"></i> Retour à l'accueil
                </button>
            </div>
        </div>

    </main>

    <script>
        // --- DATABASE ---
        // Contient les textes et images d'entraînement (en anglais pour simuler le test, instructions en français)
        const EXERCISE_DB = {
            part2: [
                {
                    type: 'text',
                    content: "The modern workplace has undergone significant changes in recent years. With the rise of digital technology, many companies now offer flexible working arrangements, including the option to work from home. This shift has not only improved work-life balance for many employees but has also allowed businesses to reduce operational costs and tap into a global talent pool. However, it requires strong communication skills and self-discipline to remain productive in a remote environment.",
                    questions: [
                        "Lisez le texte ci-dessus à voix haute.",
                        "Selon le texte, quels sont les avantages du travail flexible pour les employés et pour les entreprises ?",
                        "À votre avis, le travail à distance est-il adapté à tous les types de professions ? Pourquoi ou pourquoi pas ?"
                    ]
                },
                {
                    type: 'text',
                    content: "Environmental sustainability is no longer just a trend; it is a necessity. Cities around the world are implementing green policies, such as expanding public transportation networks, creating pedestrian-only zones, and subsidizing renewable energy sources. These initiatives aim to reduce carbon emissions and improve air quality. While these changes require significant initial investments, the long-term benefits for public health and the planet are undeniable.",
                    questions: [
                        "Lisez le texte ci-dessus à voix haute.",
                        "Quelles sont les trois initiatives écologiques mentionnées dans le texte que les villes mettent en place ?",
                        "Que faites-vous personnellement au quotidien pour contribuer à la protection de l'environnement ?"
                    ]
                },
                {
                    type: 'text',
                    content: "In recent decades, the way we consume news has transformed dramatically. Traditional newspapers and television broadcasts are increasingly being replaced by social media platforms and digital news aggregators. This instant access allows people to stay informed on global events in real-time. However, the lack of editorial oversight on some platforms has led to the rapid spread of misinformation, making critical thinking more important than ever for the modern reader.",
                    questions: [
                        "Lisez le texte ci-dessus à voix haute.",
                        "D'après ce paragraphe, quel est le principal problème lié à la consommation d'informations sur les plateformes numériques ?",
                        "Pensez-vous que les journaux imprimés finiront par disparaître complètement ? Justifiez votre opinion."
                    ]
                },
                {
                    type: 'text',
                    content: "The concept of lifelong learning has become essential in today's fast-paced economy. As automation and artificial intelligence reshape entire industries, the skills required in the workforce are constantly evolving. Employees can no longer rely solely on the education they received in their youth. Continuous professional development, through online courses, workshops, or on-the-job training, is crucial for career advancement and job security.",
                    questions: [
                        "Lisez le texte ci-dessus à voix haute.",
                        "Pourquoi l'apprentissage tout au long de la vie est-il décrit comme essentiel dans l'économie actuelle ?",
                        "Si vous deviez apprendre une nouvelle compétence aujourd'hui, laquelle choisiriez-vous et pourquoi ?"
                    ]
                },
                {
                    type: 'text',
                    content: "Tourism brings significant economic benefits to many countries, providing jobs and supporting local businesses. However, mass tourism can also have detrimental effects on popular destinations. The influx of large numbers of visitors often leads to overcrowding, pollution, and the degradation of historical sites. Finding a balance between welcoming tourists and preserving the natural and cultural heritage is a major challenge for many governments.",
                    questions: [
                        "Lisez le texte ci-dessus à voix haute.",
                        "Quels sont les effets négatifs du tourisme de masse mentionnés dans le texte ?",
                        "Quelles solutions proposeriez-vous pour encourager un tourisme plus responsable ?"
                    ]
                }
            ],
            part3: [
                {
                    type: 'images',
                    images: [
                        "https://images.unsplash.com/photo-1477959858617-67f85cf4f1df?auto=format&fit=crop&q=80&w=600&h=400", // City
                        "https://images.unsplash.com/photo-1500382017468-9049fed747ef?auto=format&fit=crop&q=80&w=600&h=400"  // Countryside
                    ],
                    questions: [
                        "Décrivez de manière détaillée les deux environnements présentés sur ces images.",
                        "Comparez les avantages et les inconvénients de la vie dans ces deux lieux différents.",
                        "Dans lequel de ces deux environnements préféreriez-vous vivre et pourquoi ?"
                    ]
                },
                {
                    type: 'images',
                    images: [
                        "https://images.unsplash.com/photo-1512820790803-83ca734da794?auto=format&fit=crop&q=80&w=600&h=400", // Reading physical book
                        "https://images.unsplash.com/photo-1526498460520-4c246339dccb?auto=format&fit=crop&q=80&w=600&h=400"  // Using tablet
                    ],
                    questions: [
                        "Décrivez l'activité principale des personnes sur ces deux images.",
                        "Comparez ces deux façons de lire ou de s'informer (support papier vs support numérique).",
                        "Pensez-vous que les livres au format papier finiront par disparaître ? Justifiez votre opinion."
                    ]
                },
                {
                    type: 'images',
                    images: [
                        "https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&q=80&w=600&h=400", // Open space office
                        "https://images.unsplash.com/photo-1593642632823-8f785ba67e45?auto=format&fit=crop&q=80&w=600&h=400"  // Home office
                    ],
                    questions: [
                        "Que montrent ces deux photographies ? Décrivez les lieux de travail.",
                        "Comparez les défis et les avantages de travailler dans un bureau traditionnel par rapport au travail à domicile.",
                        "Selon vous, à quoi ressemblera l'environnement de travail idéal dans le futur ?"
                    ]
                },
                {
                    type: 'images',
                    images: [
                        "https://images.unsplash.com/photo-1505804368945-8ceeeec2b07d?auto=format&fit=crop&q=80&w=600&h=400", // People shopping in store
                        "https://images.unsplash.com/photo-1556740758-90de374c12ad?auto=format&fit=crop&q=80&w=600&h=400"  // Person shopping online with credit card
                    ],
                    questions: [
                        "Décrivez les actions des personnes représentées sur ces images.",
                        "Quelles sont les différences majeures entre faire ses achats en magasin et acheter en ligne ?",
                        "Pensez-vous que les petits commerces de proximité peuvent survivre face au commerce en ligne ? Pourquoi ?"
                    ]
                },
                {
                    type: 'images',
                    images: [
                        "https://images.unsplash.com/photo-1534043464124-3be32fe000c9?auto=format&fit=crop&q=80&w=600&h=400", // Crowded subway/public transport
                        "https://images.unsplash.com/photo-1449965408869-eaa3f722e40d?auto=format&fit=crop&q=80&w=600&h=400"  // Person driving a car alone
                    ],
                    questions: [
                        "Décrivez les moyens de transport utilisés dans ces deux situations.",
                        "Quels sont les avantages et les inconvénients de chaque mode de déplacement pour les trajets quotidiens ?",
                        "Comment pourrions-nous encourager davantage de personnes à utiliser les transports en commun ?"
                    ]
                }
            ]
        };

        // --- STATE MANAGEMENT ---
        let state = {
            currentMode: null, // 'part2' or 'part3'
            currentItem: null,
            currentStep: 0,
            recordings: [], // { step: 0, prompt: "", audioUrl: "" }
        };

        // --- AUDIO & TIMER GLOBALS ---
        let mediaRecorder;
        let audioChunks = [];
        let timerInterval;
        let prepInterval;
        let seconds = 0;
        let prepSeconds = 30; // 30 seconds of prep time
        let maxRecordingSeconds = 60; // Limite d'enregistrement à 60 secondes par question
        let isPreparing = false;

        function hideAllViews() {
            document.getElementById('home-view').classList.add('hidden');
            document.getElementById('exercise-view').classList.add('hidden');
            document.getElementById('review-view').classList.add('hidden');
        }

        function goHome() {
            // Stop any ongoing recording/timer
            if(mediaRecorder && mediaRecorder.state === 'recording') {
                mediaRecorder.stop();
            }
            stopAllTimers();
            
            // Clear stream tracks to free mic
            if (mediaRecorder && mediaRecorder.stream) {
                mediaRecorder.stream.getTracks().forEach(track => track.stop());
                mediaRecorder = null;
            }

            hideAllViews();
            document.getElementById('home-view').classList.remove('hidden');
        }

        function startExercise(mode) {
            state.currentMode = mode;
            state.currentStep = 0;
            state.recordings = [];
            
            // Pick a random exercise from the chosen category
            const items = EXERCISE_DB[mode];
            state.currentItem = items[Math.floor(Math.random() * items.length)];

            hideAllViews();
            document.getElementById('exercise-view').classList.remove('hidden');
            
            document.getElementById('mode-label').innerText = mode === 'part2' ? 'Partie 2 (Texte)' : 'Partie 3 (Images)';
            
            renderStep();
        }

        function renderStep() {
            const contextContainer = document.getElementById('exercise-context');
            const promptContainer = document.getElementById('exercise-prompt');
            
            // Update Progress Bar & Label
            const totalSteps = state.currentItem.questions.length;
            document.getElementById('step-label').innerText = `Étape ${state.currentStep + 1} sur ${totalSteps}`;
            document.getElementById('progress-bar').style.width = `${((state.currentStep + 1) / totalSteps) * 100}%`;

            // Render Context (Text or Images)
            if (state.currentMode === 'part2') {
                contextContainer.innerHTML = `
                    <div class="text-lg leading-relaxed text-slate-700 bg-slate-50 p-6 rounded-xl border border-slate-100 font-serif">
                        ${state.currentItem.content}
                    </div>
                `;
            } else if (state.currentMode === 'part3') {
                contextContainer.innerHTML = `
                    <div class="flex flex-col md:flex-row gap-4">
                        <div class="flex-1">
                            <img src="${state.currentItem.images[0]}" alt="Image 1" class="w-full h-48 md:h-64 object-cover rounded-xl shadow-sm border border-slate-200">
                        </div>
                        <div class="flex-1">
                            <img src="${state.currentItem.images[1]}" alt="Image 2" class="w-full h-48 md:h-64 object-cover rounded-xl shadow-sm border border-slate-200">
                        </div>
                    </div>
                `;
            }

            // Render Current Question
            promptContainer.innerHTML = `
                <span class="block text-sm text-primary font-bold uppercase tracking-wider mb-2">Question ${state.currentStep + 1}</span>
                ${state.currentItem.questions[state.currentStep]}
            `;

            // If already recorded (user went back? Not implemented here, but good practice to check), handle it.
            if (state.recordings[state.currentStep]) {
                stopAllTimers();
                document.getElementById('timer-label').innerText = 'Terminé';
                document.getElementById('timer-label').className = 'text-sm font-bold uppercase tracking-wider mb-1 text-slate-500';
                document.getElementById('timer-display').innerText = '--:--';
                document.getElementById('timer-display').classList.remove('text-red-600');
                document.getElementById('timer-display').classList.add('text-slate-700');

                document.getElementById('next-btn').classList.remove('hidden');
                document.getElementById('record-btn').classList.remove('hidden');
                document.getElementById('record-btn').innerHTML = '<i class="fa-solid fa-rotate-right mr-2"></i> Refaire l\'enregistrement';
                document.getElementById('record-btn').classList.replace('bg-red-500', 'bg-slate-200');
                document.getElementById('record-btn').classList.replace('hover:bg-red-600', 'hover:bg-slate-300');
                document.getElementById('record-btn').classList.replace('text-white', 'text-slate-700');
                document.getElementById('record-btn').classList.remove('shadow-lg', 'shadow-red-500/30');
                
                document.getElementById('stop-btn').classList.add('hidden');
                
                // Update Next button text if it's the last step
                const totalSteps = state.currentItem.questions.length;
                if (state.currentStep === totalSteps - 1) {
                    document.getElementById('next-btn').innerHTML = 'Terminer et Écouter <i class="fa-solid fa-flag-checkered"></i>';
                    document.getElementById('next-btn').classList.replace('bg-primary', 'bg-green-600');
                    document.getElementById('next-btn').classList.replace('hover:bg-blue-700', 'hover:bg-green-700');
                    document.getElementById('next-btn').classList.replace('shadow-blue-500/30', 'shadow-green-500/30');
                }
            } else {
                startPreparation();
            }
        }

        function playBeep() {
            try {
                const ctx = new (window.AudioContext || window.webkitAudioContext)();
                const osc = ctx.createOscillator();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(440, ctx.currentTime);
                osc.connect(ctx.destination);
                osc.start();
                osc.stop(ctx.currentTime + 0.5);
            } catch(e) {
                // Le navigateur peut bloquer l'audio si l'utilisateur n'a pas encore interagi avec la page
            }
        }

        function startPreparation() {
            stopAllTimers();
            isPreparing = true;
            prepSeconds = 30; // 30 secondes de préparation par défaut
            
            // Update UI for prep
            document.getElementById('timer-label').innerText = 'Temps de préparation';
            document.getElementById('timer-label').className = 'text-sm font-bold uppercase tracking-wider mb-1 text-orange-500';
            document.getElementById('timer-display').classList.remove('text-red-600');
            document.getElementById('timer-display').classList.add('text-slate-700');
            
            updatePrepTimerDisplay();

            // Buttons
            const recordBtn = document.getElementById('record-btn');
            recordBtn.classList.remove('hidden', 'bg-slate-200', 'hover:bg-slate-300', 'text-slate-700');
            recordBtn.classList.add('bg-red-500', 'hover:bg-red-600', 'text-white', 'shadow-lg', 'shadow-red-500/30');
            recordBtn.innerHTML = '<i class="fa-solid fa-forward-step mr-2"></i> Passer la préparation (Enregistrer)';
            
            document.getElementById('stop-btn').classList.add('hidden');
            document.getElementById('next-btn').classList.add('hidden');

            // Reset Next button styling to default
            const nextBtn = document.getElementById('next-btn');
            nextBtn.innerHTML = 'Étape suivante <i class="fa-solid fa-arrow-right"></i>';
            nextBtn.classList.remove('bg-green-600', 'hover:bg-green-700', 'shadow-green-500/30');
            nextBtn.classList.add('bg-primary', 'hover:bg-blue-700', 'shadow-blue-500/30');

            prepInterval = setInterval(() => {
                prepSeconds--;
                updatePrepTimerDisplay();
                
                if (prepSeconds <= 0) {
                    playBeep();
                    startRecording(); // Lancement automatique
                }
            }, 1000);
        }

        function updatePrepTimerDisplay() {
            const mins = Math.floor(prepSeconds / 60).toString().padStart(2, '0');
            const secs = (prepSeconds % 60).toString().padStart(2, '0');
            document.getElementById('timer-display').innerText = `${mins}:${secs}`;
        }

        async function startRecording() {
            document.getElementById('mic-error').classList.add('hidden');
            stopAllTimers();
            isPreparing = false;

            try {
                // Initialize MediaRecorder if not already done or if stream is inactive
                if (!mediaRecorder || mediaRecorder.state === 'inactive' && !mediaRecorder.stream.active) {
                    const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                    mediaRecorder = new MediaRecorder(stream);
                    
                    mediaRecorder.ondataavailable = (event) => {
                        if (event.data.size > 0) {
                            audioChunks.push(event.data);
                        }
                    };
                    
                    mediaRecorder.onstop = () => {
                        const audioBlob = new Blob(audioChunks, { type: 'audio/webm' });
                        const audioUrl = URL.createObjectURL(audioBlob);
                        
                        // Save recording
                        state.recordings[state.currentStep] = {
                            step: state.currentStep,
                            prompt: state.currentItem.questions[state.currentStep],
                            audioUrl: audioUrl
                        };
                        
                        audioChunks = []; // Clear for next time
                        
                        // Show Next/Finish button
                        document.getElementById('record-btn').classList.remove('hidden');
                        document.getElementById('record-btn').innerHTML = '<i class="fa-solid fa-rotate-right mr-2"></i>Recommencer';
                        document.getElementById('record-btn').classList.replace('bg-red-500', 'bg-slate-200');
                        document.getElementById('record-btn').classList.replace('hover:bg-red-600', 'hover:bg-slate-300');
                        document.getElementById('record-btn').classList.replace('text-white', 'text-slate-700');
                        document.getElementById('record-btn').classList.remove('shadow-lg', 'shadow-red-500/30');

                        document.getElementById('stop-btn').classList.add('hidden');
                        document.getElementById('next-btn').classList.remove('hidden');

                        const totalSteps = state.currentItem.questions.length;
                        if (state.currentStep === totalSteps - 1) {
                            document.getElementById('next-btn').innerHTML = 'Terminer et Écouter <i class="fa-solid fa-flag-checkered"></i>';
                            document.getElementById('next-btn').classList.replace('bg-primary', 'bg-green-600');
                            document.getElementById('next-btn').classList.replace('hover:bg-blue-700', 'hover:bg-green-700');
                            document.getElementById('next-btn').classList.replace('shadow-blue-500/30', 'shadow-green-500/30');
                        }
                    };
                }

                document.getElementById('timer-label').innerText = 'Enregistrement en cours (1 minute max)';
                document.getElementById('timer-label').className = 'text-sm font-bold uppercase tracking-wider mb-1 text-red-500 recording-pulse-text';
                document.getElementById('timer-display').classList.remove('text-slate-700');
                document.getElementById('timer-display').classList.add('text-red-600');

                document.getElementById('record-btn').classList.add('hidden');
                document.getElementById('stop-btn').classList.remove('hidden');
                document.getElementById('next-btn').classList.add('hidden');

                // Lancer le timer de l'enregistrement et surveiller la limite de temps
                timerInterval = setInterval(() => {
                    seconds++;
                    updateTimerDisplay();

                    if (seconds >= maxRecordingSeconds) {
                        stopRecording();
                        // Optionnel : avertir l'utilisateur que le temps est écoulé
                        document.getElementById('timer-label').innerText = 'Temps écoulé !';
                    }
                }, 1000);

            } catch (err) {
                console.error("Microphone access denied or error:", err);
                document.getElementById('mic-error').classList.remove('hidden');
            }
        }

        function stopRecording() {
            if (mediaRecorder && mediaRecorder.state === 'recording') {
                mediaRecorder.stop();
                stopAllTimers();
                document.getElementById('timer-label').innerText = 'Enregistrement terminé';
                document.getElementById('timer-label').className = 'text-sm font-bold uppercase tracking-wider mb-1 text-slate-500';
                document.getElementById('timer-display').classList.remove('text-red-600');
                document.getElementById('timer-display').classList.add('text-slate-700');
            }
        }

        function stopAllTimers() {
            clearInterval(prepInterval);
            clearInterval(timerInterval);
        }

        function updateTimerDisplay() {
            const mins = Math.floor(seconds / 60).toString().padStart(2, '0');
            const secs = (seconds % 60).toString().padStart(2, '0');
            document.getElementById('timer-display').innerText = `${mins}:${secs}`;
        }

        function nextStep() {
            const totalSteps = state.currentItem.questions.length;
            
            if (state.currentStep < totalSteps - 1) {
                state.currentStep++;
                renderStep();
            } else {
                // Finish exercise
                renderReview();
            }
        }

        function renderReview() {
            // Free the microphone
            if (mediaRecorder && mediaRecorder.stream) {
                mediaRecorder.stream.getTracks().forEach(track => track.stop());
                mediaRecorder = null;
            }

            hideAllViews();
            document.getElementById('review-view').classList.remove('hidden');

            const reviewList = document.getElementById('review-list');
            reviewList.innerHTML = '';

            state.recordings.forEach((rec, index) => {
                const itemHTML = `
                    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 text-left">
                        <div class="text-sm font-bold text-primary mb-1">Question ${index + 1}</div>
                        <p class="text-slate-800 font-medium mb-4">${rec.prompt}</p>
                        <audio controls class="w-full h-10 outline-none">
                            <source src="${rec.audioUrl}" type="audio/webm">
                            Votre navigateur ne supporte pas l'élément audio.
                        </audio>
                    </div>
                `;
                reviewList.innerHTML += itemHTML;
            });
        }
    </script>
</body>
</html>
